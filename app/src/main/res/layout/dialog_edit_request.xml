<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Request Edit for Completed Task"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Explain the correction needed. An administrator must approve this before the task can be modified."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/etEditReason"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_edit_text"
        android:hint="Provide detailed reason for edit..."
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCancelEditRequest"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Cancel"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSubmitEditRequest"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Submit Request"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
